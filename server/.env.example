# Port the Express API listens on (the Vite dev server proxies /api to it). Default: 5000
PORT=5000

# Required. MongoDB connection string, e.g. a MongoDB Atlas mongodb+srv:// URI or mongodb://localhost:27017/ai-chat-assistant
MONGODB_URI=

# Optional. Comma-separated DNS servers for Node (e.g. 8.8.8.8,1.1.1.1). Set only if mongodb+srv:// fails with "querySrv ECONNREFUSED"
DNS_SERVERS=

# Required. Groq API key, free at https://console.groq.com/keys
GROQ_API_KEY=

# Required. Groq model that writes the chat replies
CHAT_MODEL=openai/gpt-oss-120b

# Required. Smaller, faster Groq model for conversation titles and follow-up questions
UTILITY_MODEL=openai/gpt-oss-20b

# Origin allowed by CORS (the client's URL). If empty, cross-origin requests are refused; the Vite dev proxy does not need CORS
CLIENT_ORIGIN=http://localhost:5173

# How many recent messages are sent to the model as context. Default: 20
MAX_CONTEXT_MESSAGES=20

# Maximum characters in a single user message. Default: 4000
MAX_MESSAGE_LENGTH=4000
